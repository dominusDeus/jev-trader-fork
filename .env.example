# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Simulation is the default even with a key. Live requires explicit DRY_RUN=false and a valid key.
# Startup never deposits funds or approves tokens. Fund margin separately before considering live.
# Current reconciliation/risk-budget work is still incomplete; keep DRY_RUN=true during development.
PRIVATE_KEY=
DRY_RUN=true
# Live journal: persistent local volume required; one writer, dedicated signer.
# Do not delete to bypass recovery. A used wallet needs an imported/reconciled journal.
STATE_PATH=data/live.sqlite
# Lifetime conservative gas allocation in MON, including cancellation. Zero blocks live sends.
# Choose explicitly before live use; restarting does not reset allocated gas.
GAS_BUDGET_MON=0
# Part of GAS_BUDGET_MON reserved for cancellation, at least one gasLimit * maxFee.
# Native balance is checked separately before decisions and signatures.
CANCEL_RESERVE_MON=0

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest
# Lifetime paid-provider attempt limit, persisted before calls. Zero disables paid calls.
# Currently requires the live journal; mock simulation is unaffected.
MODEL_CALL_LIMIT=0

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100

# Kuru limit orders draw from margin. Asks need MON, bids need USDC.
# The trading process never tops up balances; MARGIN_MON/MARGIN_USDC are no longer used.
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

# Read + model + signing budget; a newer block also invalidates an unfinished decision.
DECISION_DEADLINE_MS=250
# RPC timeout; an ambiguous broadcast remains tracked and pauses new orders.
RPC_TIMEOUT_MS=5000

PORT=3000
